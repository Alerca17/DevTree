# Copy this file to .env before running the backend.
# Keep the real .env out of Git. Replace placeholders with your values.

PORT=4000
# Example MongoDB connection string (replace placeholders):
# MONGO_URI=mongodb://<usuario>:<password>@cluster0.mongodb.net:27017/<nombre_bd>?ssl=true&replicaSet=<replica>&authSource=admin&appName=DevTree
MONGO_URI=mongodb://<usuario>:<password>@cluster0.mongodb.net:27017/devtree
FRONTEND_URL=http://localhost:5173
# Secret used to sign JWTs. Use a strong random string in production.
JWT_SECRET=tu_clave_super_secreta

# Cloudinary (opcional) - para gestionar uploads de imágenes.
CLOUDINARY_NAME=tu_cloudinary_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret